# ── Femi9 backend environment (see Backend PRD §5) ────────────────────────
# Copy to `.env` and fill in. Never commit real secrets.

# Postgres — pooled URL for the app, direct URL for migrations (Neon/Vercel PG)
DATABASE_URL="postgresql://user:password@localhost:5432/femi9?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/femi9?schema=public"

# Auth.js session signing
AUTH_SECRET=""

# Explicit provider mocks. Keep false/absent in production.
ALLOW_MOCK_PROVIDERS="true"

# Razorpay
#
# RAZORPAY_WEBHOOK_SECRET is NOT optional once subscriptions are live. A mandate
# debits on Razorpay's schedule with no browser involved, and the signed
# `subscription.charged` event is the ONLY notification that it happened - with
# no secret to verify it, every recurring charge is taken from a customer's
# account and no order is ever created for it.
#
# The Razorpay dashboard must have these events enabled on the webhook:
#   payment.captured  order.paid
#   subscription.authenticated  subscription.activated  subscription.charged
#   subscription.pending  subscription.halted  subscription.paused
#   subscription.resumed  subscription.cancelled  subscription.completed
#
# Recurring payments must also be ENABLED on the merchant account (Razorpay
# gates it per account); without it every plan/subscription API call 400s and
# "Start subscription" fails with a gateway error nobody on this side can fix.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Transactional email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="Femi9 <login@example.com>"
RESEND_WEBHOOK_SECRET=""
PARTNER_OPS_EMAIL=""

# Phone OTP + order notifications (WhatsApp Cloud API)
# Sign-in codes go out on WhatsApp and NOWHERE else - there is no SMS fallback -
# so without these two nobody can sign in with a phone number. The phone number
# id is the Cloud API's numeric sender id, not the number itself. Templates must
# already be approved on the WABA: signup_otp, login_otp,
# order_status_confirmation, order_status_delivered, order_status_cancell.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID="323448914175098"
# Optional. Defaults to v22.0 / en_US. The five templates are approved under
# en_US; Meta matches on the name AND language PAIR, so login_otp/en is a
# different template from login_otp/en_US and a mismatch answers 132001,
# "template does not exist", without saying which half was wrong.
WHATSAPP_API_VERSION=""
WHATSAPP_TEMPLATE_LANGUAGE=""

# SMS (MSG91) - no longer on the sign-in path. Still the only way a phone-only
# customer receives a redeemed reward code, which also needs the flow template.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_FLOW_TEMPLATE_ID=""

# Object storage (private S3 via CloudFront; Cloudinary is an alternative)
UPLOADS_BUCKET=""
CLOUDINARY_URL=""

# Shared rate limiting. Terraform/ECS injects RATE_LIMIT_TABLE. Upstash is an
# optional alternative for non-AWS deployments.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# AWS ECS/Terraform injects this shared rate-limit table automatically.
RATE_LIMIT_TABLE=""

# Observability
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.02"
# Build-time source-map upload (CI only)
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# 32 random bytes encoded as base64. Protects period/symptom payloads at rest.
CYCLE_DATA_ENCRYPTION_KEY=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Thara Model feature flag (sub-projects A–F). Off by default; every new
# Thara route 404s until this is exactly the string "true".
THARA_ENABLED="false"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the Google Web OAuth client.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Environment-based admin bootstrap (kept separate from customer auth).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# EventBridge/operations cron authentication.
CRON_SECRET=""

# Thara voucher fulfilment. Keep `manual` until an issuer is configured.
THARA_VOUCHER_ISSUER="manual"
INCENTIVES_PARTNER_ID=""
AWS_INCENTIVES_ACCESS_KEY_ID=""
AWS_INCENTIVES_SECRET_ACCESS_KEY=""

# ── Two-brand platform (Phase 2) ─────────────────────────────────────────────
# Per-brand databases. One Postgres instance, one schema per brand. Femi9 still
# falls back to DATABASE_URL above until the `public` -> `femi9` rename lands.
DATABASE_URL_FEMI9=""
DATABASE_URL_LUMI9=""
# Admin identity lives in its own schema, reachable by neither brand's client.
DATABASE_URL_PLATFORM=""
# Signing key for admin console sessions. Falls back to AUTH_SECRET if unset,
# but a separate key means a leaked storefront secret does not mint ops sessions.
ADMIN_AUTH_SECRET=""
# Where the ops console lives. When set, /admin on the storefront redirects
# there; when unset there is simply no /admin route. The console itself is
# apps/admin and authenticates per brand — see apps/admin/CLAUDE.md.
ADMIN_CONSOLE_URL=""

# ── Per-brand mail identity (Phase 4c) ───────────────────────────────────────
# Each brand sends under its own FROM address; a Lumi9 parent receiving a
# Femi9-branded sign-in link reads as phishing. Both fall back to the shared
# vars above, so Lumi9 can run on Femi9's Resend account today and move to its
# own by setting one variable — no code change.
# The KEY may reasonably stay shared (one account can send for several verified
# domains). The FROM address should not: it must be a domain that brand has
# verified, or delivery suffers and the mail looks wrong.
RESEND_API_KEY_FEMI9=""
RESEND_API_KEY_LUMI9=""
EMAIL_FROM_FEMI9=""
EMAIL_FROM_LUMI9=""

# ── Per-brand payments (Phase 4d) ────────────────────────────────────────────
# Same fallback shape as the database and mail: per-brand first, then shared.
# Lumi9 runs on Femi9's Razorpay account today; give it its own by setting these.
#
# The WEBHOOK secret is the sharp edge. Razorpay signs an event with the secret
# of the account that RAISED the charge, so once the accounts differ, a Lumi9
# payment verified against Femi9's secret fails its signature check, the order
# is never marked paid, and nobody sees an error. Each brand therefore has its
# own webhook endpoint — point each Razorpay dashboard at its own URL.
RAZORPAY_KEY_ID_FEMI9=""
RAZORPAY_KEY_SECRET_FEMI9=""
RAZORPAY_WEBHOOK_SECRET_FEMI9=""
NEXT_PUBLIC_RAZORPAY_KEY_ID_FEMI9=""
RAZORPAY_KEY_ID_LUMI9=""
RAZORPAY_KEY_SECRET_LUMI9=""
RAZORPAY_WEBHOOK_SECRET_LUMI9=""
NEXT_PUBLIC_RAZORPAY_KEY_ID_LUMI9=""
